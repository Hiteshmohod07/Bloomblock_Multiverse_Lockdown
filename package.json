{
  "name": "bloomlock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A turn-based maze through a fractured Sanctum.",
  "scripts": {
    "start": "npm run build && node scripts/serve.mjs",
    "dev": "vite --config vite.config.mjs",
    "build": "node scripts/import-audio.mjs && vite build --config vite.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "verify": "node scripts/verify-levels.mjs",
    "verify:write": "node scripts/verify-levels.mjs --write"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "canvas-confetti": "1.9.4"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "typescript": "^6.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/canvas-confetti": "^1.9.0"
  }
}
